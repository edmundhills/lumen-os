# The lint tools, so that `just lint` gives the same result in WSL and in CI.
# All of them come from Fedora's own repositories. The base is pinned by digest
# (Fedora 44, 2026-10-27); Renovate will bump it from step 8.2.

FROM quay.io/fedora/fedora:44@sha256:e34bf26713717aed250ebb18b959df39bca38a0e4a5cb9eb024b8e19c41162e2

RUN dnf install -y --setopt=install_weak_deps=False \
        git-core \
        just \
        markdownlint-cli2 \
        python3 \
        reuse \
        ShellCheck \
        shfmt \
    && dnf clean all \
    # The checkout is mounted from the host, so its owner may differ from the
    # container's user; git would then refuse to read it.
    && git config --system --add safe.directory '*'
