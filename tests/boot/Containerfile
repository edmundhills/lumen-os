# The VM the boot test runs (tests/boot/boot_iso.py): QEMU, the UEFI firmware
# Fedora builds for it, with Secure Boot and Microsoft's keys (edk2-ovmf), and
# Python, from Fedora's own repositories, so the test runs the same in CI and
# in WSL.
#
# The base is the lint container's Fedora, by the same pin, so the base
# workflow moves both with one pin (step 1.5b). Whoever builds it passes that
# pin, as boot-iso.yml and `just boot-iso` do:
#   --build-arg FEDORA="$(sed -n 's/^FROM //p' tests/lint/Containerfile)"
ARG FEDORA
FROM ${FEDORA}

RUN dnf install -y --setopt=install_weak_deps=False \
        edk2-ovmf \
        python3 \
        python3-pyyaml \
        qemu-system-x86-core \
    && dnf clean all
