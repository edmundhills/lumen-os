#
# RPM Fusion's nonfree repositories for Fedora, as the lumen-gaming stage of
# image/Containerfile uses them for one step: turned on, and limited with
# includepkgs to Steam and, on the NVIDIA edition, NVIDIA's 32-bit libraries,
# which NVIDIA's driver requires once Steam brings 32-bit Mesa, so nothing else
# can come from them (steps 1.10a and 1.12b, docs/decisions/0019-gaming-edition.md). The stage copies this file into
# /etc/yum.repos.d and deletes it again in the same step, so the image keeps no
# repository. The definitions are RPM Fusion's own (rpmfusion-nonfree.repo and
# rpmfusion-nonfree-updates.repo in github.com/rpmfusion/rpmfusion-nonfree-release
# at aa70b42), and the key is RPM Fusion's, next to this file, which the stage
# checks against keys.sha256 first.

[lumen-rpmfusion-nonfree]
name=RPM Fusion for Fedora $releasever - Nonfree, Steam and NVIDIA's 32-bit libraries
metalink=https://mirrors.rpmfusion.org/metalink?repo=nonfree-fedora-$releasever&arch=$basearch
enabled=1
includepkgs=steam,xorg-x11-drv-nvidia-libs
type=rpm-md
gpgcheck=1
repo_gpgcheck=0
gpgkey=file:///run/lumen/gaming/RPM-GPG-KEY-rpmfusion-nonfree-fedora-2020

[lumen-rpmfusion-nonfree-updates]
name=RPM Fusion for Fedora $releasever - Nonfree - Updates, Steam and NVIDIA's 32-bit libraries
metalink=https://mirrors.rpmfusion.org/metalink?repo=nonfree-fedora-updates-released-$releasever&arch=$basearch
enabled=1
includepkgs=steam,xorg-x11-drv-nvidia-libs
type=rpm-md
gpgcheck=1
repo_gpgcheck=0
gpgkey=file:///run/lumen/gaming/RPM-GPG-KEY-rpmfusion-nonfree-fedora-2020
