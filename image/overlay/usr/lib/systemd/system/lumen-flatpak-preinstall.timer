#
# Starts lumen-flatpak-preinstall.service two minutes after each start, so the
# download doesn't hold up the login screen or the first-run setup, and again
# a quarter of an hour after any run that was skipped for want of a network or
# that failed, until one has worked (the service says how).

[Unit]
Description=Install the Flatpak apps that come with Lumen, after each start
Documentation=https://github.com/edmundhills/lumen-os/blob/main/image/README.md

[Timer]
OnBootSec=2min
OnUnitInactiveSec=15min

[Install]
WantedBy=timers.target
