#
# Starts lumen-flatpak-preinstall.service two minutes after each start, so the
# download doesn't hold up the login screen or the first-run setup.

[Unit]
Description=Install the Flatpak apps that come with Lumen, after each start
Documentation=https://github.com/edmundhills/lumen-os/blob/main/image/README.md

[Timer]
OnBootSec=2min

[Install]
WantedBy=timers.target
