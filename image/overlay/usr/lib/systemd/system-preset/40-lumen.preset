#
# Which units Lumen turns on. systemd reads every preset file in name order and
# the first line that names a unit wins, so these lines come before Fedora's
# (80- to 99-). The image build applies them, and so does systemd on a new
# machine's first boot. Fedora already turns on firewalld and tuned; they are
# listed so the image check (image/check-image.sh) holds them to it.
#
# The image also masks Fedora's own updaters and its weekly countme ping
# (image/Containerfile), which a preset can't do.

# The firewall, public zone by default (spec, "Spec: security model")
enable firewalld.service

# Fetch new firmware metadata, so Settings can offer firmware updates
enable fwupd-refresh.timer

# Snapper's hourly snapshots and their cleanup. With no snapper config they do
# nothing; step 1.4 adds the config for /home
enable snapper-timeline.timer
enable snapper-cleanup.timer

# Power profiles through tuned (docs/architecture.md, Q2)
enable tuned.service
enable tuned-ppd.service
