#
# Snapper's settings for Lumen's hourly snapshots of /home: keep 24 hourly,
# 7 daily and 4 weekly ones (spec, "Snapshots and backup"). Files shows them as
# "Previous versions" (step 6.9).
#
# lumen-home-snapshots makes /etc/snapper/configs/home from this template on a
# machine's first boot, with SUBVOLUME set to /var/home. Each setting is
# explained in `man snapper-configs`. The values are snapper's own defaults,
# apart from the TIMELINE_LIMIT_ lines.

SUBVOLUME="/"
FSTYPE="btrfs"
QGROUP=""
SPACE_LIMIT="0.5"
FREE_LIMIT="0.2"
ALLOW_USERS=""
ALLOW_GROUPS=""
SYNC_ACL="no"
BACKGROUND_COMPARISON="yes"
NUMBER_CLEANUP="yes"
NUMBER_MIN_AGE="3600"
NUMBER_LIMIT="50"
NUMBER_LIMIT_IMPORTANT="10"
TIMELINE_CREATE="yes"
TIMELINE_CLEANUP="yes"
TIMELINE_MIN_AGE="3600"
TIMELINE_LIMIT_HOURLY="24"
TIMELINE_LIMIT_DAILY="7"
TIMELINE_LIMIT_WEEKLY="4"
TIMELINE_LIMIT_MONTHLY="0"
TIMELINE_LIMIT_QUARTERLY="0"
TIMELINE_LIMIT_YEARLY="0"
EMPTY_PRE_POST_CLEANUP="yes"
EMPTY_PRE_POST_MIN_AGE="3600"
