#!/usr/bin/bash
# SPDX-FileCopyrightText: 2026 Lumen OS contributors
#
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Make a video's thumbnail with the codecs of Flathub's freedesktop runtime,
# H.264 and HEVC included, which Lumen's image doesn't carry (step 1.14b,
# docs/decisions/0025-codecs.md). KDE's previews run this for the types in
# /usr/share/thumbnailers/lumen-video.thumbnailer.
#
# Usage: lumen-video-thumbnailer SIZE INPUT OUTPUT
#
# SIZE is the longer side of the thumbnail in pixels, INPUT the video, OUTPUT
# the PNG to write. The runtime's ffmpeg runs in `flatpak run --sandbox`, with
# no network and no access to any file: the video goes in on standard input,
# which stays a file it can seek in, and the PNG comes out on standard output.
# So a malformed video is parsed in a sandbox, not in the file manager. It
# picks a representative frame from about 3 seconds in, or from the start of a
# shorter video.
#
# Uses the newest branch of org.freedesktop.Platform that is installed, which
# lumen-flatpak-preinstall.timer installs with its codecs-extra extension.
# Exits 0 with OUTPUT written, 1 when no thumbnail can be made (no runtime yet,
# or not a video it can read), 2 on a usage error.

set -euo pipefail

readonly RUNTIME=org.freedesktop.Platform

if (($# != 3)) || [[ ! $1 =~ ^[1-9][0-9]{0,3}$ ]]; then
  printf 'Usage: %s SIZE INPUT OUTPUT\n' "${0##*/}" >&2
  exit 2
fi
readonly size=$1 input=$2 output=$3

if [[ ! -f $input || ! -r $input ]]; then
  printf '%s: %s is not a file it can read\n' "${0##*/}" "$input" >&2
  exit 1
fi

# The newest branch of the runtime, system-wide or the user's: 25.08, 26.08 and
# so on.
branch=$(flatpak list --runtime --columns=application,branch 2>/dev/null |
  awk -v id="$RUNTIME" '$1 == id && $2 ~ /^[0-9]+\.[0-9]+$/ { print $2 }' | sort -V | tail -n 1)
if [[ -z $branch ]]; then
  printf '%s: %s is not installed yet\n' "${0##*/}" "$RUNTIME" >&2
  exit 1
fi

# frame [FFMPEG_OPTION...]: write one PNG frame of the video to standard output.
frame() {
  timeout 30 flatpak run --sandbox --die-with-parent --unshare=network --unshare=ipc \
    --command=ffmpeg "$RUNTIME//$branch" -nostdin -hide_banner -loglevel error \
    "$@" -i /dev/stdin -frames:v 1 \
    -vf "thumbnail=25,scale=w=$size:h=$size:force_original_aspect_ratio=decrease" \
    -f image2pipe -c:v png pipe:1 <"$input"
}

tmp=$(mktemp -- "$output.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT
if { frame -ss 3 >"$tmp" && [[ -s $tmp ]]; } || { frame >"$tmp" && [[ -s $tmp ]]; }; then
  mv -f -- "$tmp" "$output"
  exit 0
fi
printf '%s: no frame could be read from %s\n' "${0##*/}" "$input" >&2
exit 1
