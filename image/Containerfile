# The Lumen OS image: Fedora Kinoite with Lumen's packages, run by bootc.
# docs/architecture.md, section 9.3, describes every stage. Phase 1 has two:
#
#   base    Kinoite, pinned by digest, with the changes in image/packages.toml.
#           Every later stage derives from it.
#   lumen   The image users get. It ends with `bootc container lint`.
#
# Build it from the top of the repository with `just build-image`, which runs
#   podman build --file image/Containerfile --target lumen \
#     --build-arg LUMEN_BUILD_VERSION=<version> --build-arg LUMEN_COMMIT=<commit> .
# CI builds it the same way (.github/workflows/build-image.yml), then re-chunks
# it into the layers users download (image/rechunk.sh, ADR 0007).

# Fedora Kinoite, pinned by the digest of its multi-architecture index
# (docs/versions.md). quay.io deletes dated builds four weeks after they are
# made, so the base workflow (.github/workflows/base.yml) moves the pin to the
# newest build every week through a pull request, rewriting the "Pinned:" line,
# and keeps a copy of each pinned base on ghcr.io (step 1.5b, ADR 0004).
# Pinned: Kinoite 44.20261028.0, built 2026-10-28, with KWin 6.7.5, Plasma 6.7.5 and Qt 6.11.2.
FROM quay.io/fedora-ostree-desktops/kinoite:44@sha256:93139a85f048799787b472307c8da8b5304bbfe247c2fae75cfeafc7035b38ac AS base

# Install and remove packages. packages.py stops the build if the manifest
# doesn't match the base image, or if dnf removes a package it doesn't list.
# Then remove what dnf leaves behind: its lock in /run, and its cache, repo
# state, log and ldconfig's cache in /var. bootc fills /var only on the first
# install, so the image keeps nothing there that systemd-tmpfiles doesn't
# create, and bootc container lint warns about anything else. Kinoite's own
# /var holds only /var/tmp.
#
# Only the two files this step reads are mounted. Podman reuses a step only if
# what it mounts is unchanged, so mounting all of image/ would rerun dnf (about
# 9 minutes) after any change there, such as to the overlay.
RUN --mount=type=bind,source=image/packages.py,target=/run/lumen/packages.py \
    --mount=type=bind,source=image/packages.toml,target=/run/lumen/packages.toml \
    python3 /run/lumen/packages.py apply /run/lumen/packages.toml \
    && rm -rf /run/dnf /var/cache/* /var/lib/dnf /var/log/*

FROM base AS lumen

# Later steps add here: the Lumen RPMs from the build stages (Phases 2 to 7).

# Copy image/overlay into the image. cp sets the modes itself rather than
# keeping the checkout's, which aren't the same on every machine (in WSL, a
# Windows checkout shows every file as 0777): files get 0644 and new folders
# 0755, and Lumen's programs in /usr/libexec 0755.
#
# Then turn units on and off. systemctl applies the presets the way systemd
# does on a new machine's first boot, which turns on only what a preset
# enables. And it masks three timers Lumen replaces, so nothing can start them
# (docs/architecture.md, section 4.1):
#   rpm-ostreed-automatic.timer, bootc-fetch-apply-updates.timer
#       Fedora's updaters. The bootc one applies updates and reboots without
#       asking. lumen-updated (Phase 5) owns updates.
#   rpm-ostree-countme.timer
#       Sends Fedora a weekly anonymous count. Lumen has no telemetry (spec).
RUN --mount=type=bind,source=image/overlay,target=/run/lumen/overlay \
    cp --recursive --no-preserve=mode,ownership /run/lumen/overlay/. / \
    && chmod 0755 /usr/libexec/lumen-* \
    && systemctl preset-all --preset-mode=enable-only \
    && systemctl mask rpm-ostreed-automatic.timer bootc-fetch-apply-updates.timer \
        rpm-ostree-countme.timer

# The build version: <Fedora release>.<build date>, with .1, .2 for further
# builds on the same day (docs/architecture.md, section 9.7). image/build_version.py
# works it out for CI and `just build-image`. It changes with every build, so
# the steps from here on always run again; they take seconds.
ARG LUMEN_BUILD_VERSION

# Say in os-release that this is Lumen, with ID_LIKE=fedora for the tools that
# look for Fedora (image/os-release.sh).
RUN --mount=type=bind,source=image/os-release.sh,target=/run/lumen/os-release.sh \
    bash /run/lumen/os-release.sh "$LUMEN_BUILD_VERSION"

# Mark the files that need a layer of their own when CI re-chunks the image,
# such as the initramfs and os-release (image/layer_hints.py, ADR 0007).
RUN --mount=type=bind,source=image/layer_hints.py,target=/run/lumen/layer_hints.py \
    python3 /run/lumen/layer_hints.py

# Check what the overlay and the steps above set up (image/check-image.sh).
RUN --mount=type=bind,source=image,target=/run/lumen/image \
    bash /run/lumen/image/check-image.sh /run/lumen/image/overlay

# Catch image mistakes, such as content in /usr/etc or a missing kernel. A
# warning fails the build too, so none can pile up unnoticed.
#
# First delete /run/lumen, where the steps above mount their files. Podman 4.9.3
# (Ubuntu 24.04's, on the CI runners) leaves the empty mount points in the
# image, and the lint rejects anything in /run. Podman 5.8 in WSL removes them
# itself, so there it deletes nothing.
RUN rm -rf /run/lumen && bootc container lint --fatal-warnings

# The image labels. bootc status and Settings > Updates show the version; the
# source links the package on ghcr.io to the repository. Kinoite's other labels
# stay, among them the ostree.* labels that bootc reads when it imports the image.
ARG LUMEN_COMMIT
LABEL org.opencontainers.image.title="Lumen OS" \
      org.opencontainers.image.description="Lumen OS, a desktop Linux system built on Fedora Kinoite" \
      org.opencontainers.image.version="$LUMEN_BUILD_VERSION" \
      org.opencontainers.image.revision="$LUMEN_COMMIT" \
      org.opencontainers.image.source="https://github.com/edmundhills/lumen-os" \
      org.opencontainers.image.url="https://github.com/edmundhills/lumen-os"
