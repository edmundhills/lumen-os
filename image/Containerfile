# The Lumen OS image: Fedora Kinoite with Lumen's packages, run by bootc.
# docs/architecture.md, section 9.3, describes every stage. Phase 1 has three:
#
#   base    Kinoite, pinned by digest, with the changes in image/packages.toml.
#           Every later stage derives from it.
#   lumen   The image users get. It ends with `bootc container lint`.
#   live    The live system the install ISO boots, derived from lumen. It is
#           only ever packed into an ISO, never pushed as an image.
#
# Build it from the top of the repository with `just build-image`, which runs
#   podman build --file image/Containerfile --target lumen \
#     --build-arg LUMEN_BUILD_VERSION=<version> --build-arg LUMEN_COMMIT=<commit> .
# CI builds it the same way (.github/workflows/build-image.yml), then re-chunks
# it into the layers users download (image/rechunk.sh, ADR 0007).
# `just build-live` builds the live stage the same way, with --target live.

# What the live stage builds on: the lumen stage of this build, unless
# --build-arg LUMEN_LIVE_FROM=<image> names a build of it already made, such as
# a published one by digest. Then Podman builds only the live stage, and the
# live session is exactly that build.
ARG LUMEN_LIVE_FROM=lumen

# Fedora Kinoite, pinned by the digest of its multi-architecture index
# (docs/versions.md). quay.io deletes dated builds four weeks after they are
# made, so the base workflow (.github/workflows/base.yml) moves the pin to the
# newest build every week through a pull request, rewriting the "Pinned:" line,
# and keeps a copy of each pinned base on ghcr.io (step 1.5b, ADR 0004).
# Pinned: Kinoite 45.20261101.0, built 2026-11-01, with KWin 6.8.2, Plasma 6.8.2 and Qt 6.11.2.
FROM quay.io/fedora-ostree-desktops/kinoite:45@sha256:bfe08b1033bfc1736f47eb377b8dc83163605cc140502c0631b80f0f19b1be34 AS base

# Install and remove packages. packages.py stops the build if the manifest
# doesn't match the base image, or if dnf removes a package it doesn't list.
# Then remove what dnf leaves behind: its lock in /run, and its cache, repo
# state, log and ldconfig's cache in /var. bootc fills /var only on the first
# install, so the image keeps nothing there that systemd-tmpfiles doesn't
# create, and bootc container lint warns about anything else. Kinoite's own
# /var holds only /var/tmp.
#
# Only the two files this step reads are mounted. Podman reuses a step only if
# what it mounts is unchanged, so mounting all of image/ would rerun dnf (about
# 9 minutes) after any change there, such as to the overlay.
#
# Python runs in this build without writing bytecode files (.pyc): the build's
# scripts must not change the image beyond what they are for. Python writes one
# for any module it imports that has none, and such a file belongs to no
# package, so it would land in the large layer of files no package owns, which
# users then download again (ADR 0007). The same goes for every step below
# that runs Python, and for image/check-image.sh.
RUN --mount=type=bind,source=image/packages.py,target=/run/lumen/packages.py \
    --mount=type=bind,source=image/packages.toml,target=/run/lumen/packages.toml \
    PYTHONDONTWRITEBYTECODE=1 python3 /run/lumen/packages.py apply /run/lumen/packages.toml \
    && rm -rf /run/dnf /var/cache/* /var/lib/dnf /var/log/*

FROM base AS lumen

# Later steps add here: the Lumen RPMs from the build stages (Phases 2 to 7).

# Copy image/overlay into the image. cp sets the modes itself rather than
# keeping the checkout's, which aren't the same on every machine (in WSL, a
# Windows checkout shows every file as 0777): files get 0644 and new folders
# 0755, and Lumen's programs in /usr/libexec 0755.
#
# Then turn units on and off. systemctl applies the presets the way systemd
# does on a new machine's first boot, which turns on only what a preset
# enables. And it masks three timers Lumen replaces, so nothing can start them
# (docs/architecture.md, section 4.1):
#   rpm-ostreed-automatic.timer, bootc-fetch-apply-updates.timer
#       Fedora's updaters. The bootc one applies updates and reboots without
#       asking. lumen-updated (Phase 5) owns updates.
#   rpm-ostree-countme.timer
#       Sends Fedora a weekly anonymous count. Lumen has no telemetry (spec).
RUN --mount=type=bind,source=image/overlay,target=/run/lumen/overlay \
    cp --recursive --no-preserve=mode,ownership /run/lumen/overlay/. / \
    && chmod 0755 /usr/libexec/lumen-* \
    && systemctl preset-all --preset-mode=enable-only \
    && systemctl mask rpm-ostreed-automatic.timer bootc-fetch-apply-updates.timer \
        rpm-ostree-countme.timer

# The build version: <Fedora release>.<build date>, with .1, .2 for further
# builds on the same day (docs/architecture.md, section 9.7). image/build_version.py
# works it out for CI and `just build-image`. It changes with every build, so
# the steps from here on always run again; they take seconds.
ARG LUMEN_BUILD_VERSION

# Say in os-release that this is Lumen, with ID_LIKE=fedora for the tools that
# look for Fedora (image/os-release.sh).
RUN --mount=type=bind,source=image/os-release.sh,target=/run/lumen/os-release.sh \
    bash /run/lumen/os-release.sh "$LUMEN_BUILD_VERSION"

# Mark the files that need a layer of their own when CI re-chunks the image,
# such as os-release and the overlay's files (image/layer_hints.py, ADR 0007).
RUN --mount=type=bind,source=image,target=/run/lumen/image \
    PYTHONDONTWRITEBYTECODE=1 python3 /run/lumen/image/layer_hints.py /run/lumen/image/overlay

# Check what the overlay and the steps above set up (image/check-image.sh).
RUN --mount=type=bind,source=image,target=/run/lumen/image \
    bash /run/lumen/image/check-image.sh /run/lumen/image/overlay

# Catch image mistakes, such as content in /usr/etc or a missing kernel. A
# warning fails the build too, so none can pile up unnoticed.
#
# First delete /run/lumen, where the steps above mount their files. Podman 4.9.3
# (Ubuntu 24.04's, on the CI runners) leaves the empty mount points in the
# image, and the lint rejects anything in /run. Podman 5.8 in WSL removes them
# itself, so there it deletes nothing.
RUN rm -rf /run/lumen && bootc container lint --fatal-warnings

# The image labels. bootc status and Settings > Updates show the version; the
# source links the package on ghcr.io to the repository. Kinoite's other labels
# stay, among them the ostree.* labels that bootc reads when it imports the image.
ARG LUMEN_COMMIT
LABEL org.opencontainers.image.title="Lumen OS" \
      org.opencontainers.image.description="Lumen OS, a desktop Linux system built on Fedora Kinoite" \
      org.opencontainers.image.version="$LUMEN_BUILD_VERSION" \
      org.opencontainers.image.revision="$LUMEN_COMMIT" \
      org.opencontainers.image.source="https://github.com/edmundhills/lumen-os" \
      org.opencontainers.image.url="https://github.com/edmundhills/lumen-os"

# The live system the install ISO boots (docs/architecture.md, section 9.6): the
# Lumen image with what the live session and the installer need, laid out as
# the container-native ISO contract v0.1.0 asks (ADR 0011), so that
# image-builder's generic-iso can pack it into an ISO (image/make-iso.sh, ADR
# 0012). LUMEN_LIVE_FROM, at the top of this file, says which build of the
# lumen stage it starts from.
FROM ${LUMEN_LIVE_FROM} AS live

# The live packages (image/live/packages.toml), applied the way the base stage
# applies image/packages.toml, and dnf's leftovers removed the same way.
RUN --mount=type=bind,source=image/packages.py,target=/run/lumen/packages.py \
    --mount=type=bind,source=image/live/packages.toml,target=/run/lumen/packages.toml \
    PYTHONDONTWRITEBYTECODE=1 python3 /run/lumen/packages.py apply /run/lumen/packages.toml \
    && rm -rf /run/dnf /var/cache/* /var/lib/dnf /var/log/*

# Anaconda's bootc install mounts SELinux's file system into the new system,
# as its other installs do (the owner's choice, ADR 0015). It binds only /proc
# and /sys there, without what is mounted below /sys, so programs it runs in
# the new system, such as chage after it sets a password, log that they
# can't read SELinux's mode. One line of Anaconda; the build stops if that
# line has changed upstream. It comes before the bytecode step below, which
# compiles the changed file again.
RUN file=$(echo /usr/lib64/python3*/site-packages/pyanaconda/modules/payloads/payload/rpm_ostree/installation.py) \
    && test "$(grep -cx '        for path in ("/proc", "/sys"):' "$file")" = 1 \
    && sed -i 's|^        for path in ("/proc", "/sys"):$|        for path in ("/proc", "/sys", "/sys/fs/selinux"):|' "$file"

# Python bytecode that matches its source. The image gives every file the
# time 0, but Fedora's .pyc files record their source's real time, so Python
# takes almost all of them for stale. The live session's /usr is writable, so
# programs write new bytecode into it, which tuned-ppd's SELinux policy logs as
# denials (ADR 0012, Follow-up). image/live/bytecode.py compiles the stale ones
# again, checked by a hash of their source instead of its time.
RUN --mount=type=bind,source=image/live/bytecode.py,target=/run/lumen/bytecode.py \
    PYTHONDONTWRITEBYTECODE=1 python3 /run/lumen/bytecode.py fix /

# An initramfs that boots from the ISO, in place of Kinoite's, which is made
# for an installed system. dracut builds it from the image's own kernel, with
# every driver (--no-hostonly) and the live modules: dmsquash-live finds the
# USB by its label and runs the system from its squashfs, and
# dmsquash-live-autooverlay gives that a writable layer in memory. The
# contract wants it next to the kernel, named initramfs.img.
#
# dracut puts root's home folder in the initramfs and stops if it can't. In
# the image, /root points to /var/roothome, which systemd-tmpfiles makes only
# at boot, so the step makes it first.
RUN mkdir -p "$(realpath /root)" \
    && kernel=$(ls /usr/lib/modules) \
    && dracut --force --zstd --reproducible --no-hostonly \
        --add "dmsquash-live dmsquash-live-autooverlay" \
        "/usr/lib/modules/$kernel/initramfs.img" "$kernel"

# The live session: at boot, livesys makes the user liveuser, with no password,
# and logs it straight into Plasma, with the installer on the desktop
# (/usr/libexec/livesys/sessions.d/livesys-kde).
RUN sed -i 's/^livesys_session=.*/livesys_session=kde/' /etc/sysconfig/livesys \
    && systemctl enable livesys.service livesys-late.service

# shim and GRUB's EFI programs where the contract wants them, in
# /boot/efi/EFI/<vendor>: bootupd keeps them in /usr/lib/efi, a folder per
# package, and the ISO tools copy them from /boot/efi.
RUN mkdir -p /boot/efi && cp -a /usr/lib/efi/*/*/EFI /boot/efi/

# The ostree repository that every build carries, which the live system
# doesn't use: it runs from the ISO's squashfs, not from an ostree deployment,
# and the installer installs the image from container storage (step 1.8c).
# The repository's files are hard links to those in /usr, and the SELinux
# policy labels the two paths differently, so each such file would get
# whichever label setfiles met first (image/check-iso.sh). Titanoboa leaves
# them out of its squashfs too (ADR 0012).
RUN rm -rf /sysroot/ostree /ostree

# The installer's install profile (installer/anaconda/lumen.conf, step 1.4),
# its kickstart, which installs the ISO's own copy of the Lumen image
# (installer/anaconda/interactive-defaults.ks, step 1.8c), and the ISO's label
# and boot menu (image/live/iso.yaml). The kickstart takes the place of
# Anaconda's own, which has no commands.
RUN --mount=type=bind,source=installer,target=/run/lumen/installer \
    --mount=type=bind,source=image/live,target=/run/lumen/live \
    install -D --mode=0644 /run/lumen/installer/anaconda/lumen.conf /etc/anaconda/profile.d/lumen.conf \
    && install -D --mode=0644 /run/lumen/installer/anaconda/interactive-defaults.ks \
        /usr/share/anaconda/interactive-defaults.ks \
    && install -D --mode=0644 /run/lumen/live/iso.yaml /usr/lib/bootc-image-builder/iso.yaml

# The installer runs with SELinux enforcing, as the rest of the live session
# does (the owner's choice, docs/decisions/0015-installer-enforcing.md).
# Fedora's liveinst, which the desktop's installer icon starts, switches
# SELinux to permissive before it starts Anaconda and back afterwards; this
# removes the switch, and stops the build if liveinst no longer has it as
# expected, so a change upstream is looked at rather than missed.
RUN grep -qx '    /usr/sbin/setenforce 0' /usr/bin/liveinst \
    && sed -i '\|^    /usr/sbin/setenforce 0$|d' /usr/bin/liveinst

# Check all of it (image/live/check-live.sh).
RUN --mount=type=bind,source=installer,target=/run/lumen/installer \
    --mount=type=bind,source=image/live,target=/run/lumen/live \
    bash /run/lumen/live/check-live.sh /run/lumen/live /run/lumen/installer
